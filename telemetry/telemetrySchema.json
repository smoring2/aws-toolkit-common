{
    "$id": "AWSToolkitTelemetry",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AWS Toolkit Telemetry",
    "type": "object",
    "properties": {
        "types": {
            "type": "array",
            "description": "Metadata used by other calls",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the metadata type",
                        "pattern": "^(?!value$|project$|createTime$)[a-zA-Z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$",
                        "maxLength": 128
                    },
                    "type": {
                        "enum": ["int", "double", "string", "boolean"]
                    },
                    "description": {
                        "type": "string",
                        "pattern": "^[^\\\\]*$",
                        "maxLength": 1024
                    },
                    "allowedValues": {
                        "oneOf": [
                            { "type": "array", "items": { "type": "number" } },
                            { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9 ,._-]*$", "maxLength": 128 } }
                        ]
                    }
                },
                "required": ["name", "description"],
                "additionalProperties": false
            }
        },
        "metrics": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the metadata type",
                        "pattern": "^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)+$",
                        "maxLength": 128
                    },
                    "description": {
                        "type": "string",
                        "pattern": "^[^\\\\]*$",
                        "maxLength": 1024
                    },
                    "unit": {
                        "enum": ["Milliseconds", "Bytes", "Percent", "Count", "None"]
                    },
                    "metadata": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string"
                                },
                                "required": {
                                    "type": "boolean"
                                }
                            },
                            "required": ["type"],
                            "additionalProperties": false
                        }
                    },
                    "passive": {
                        "type": "boolean",
                        "description": "Set as true if the metric is emitted without any explicit user action."
                    }
                },
                "required": ["name", "description"],
                "additionalProperties": false
            }
        }
    },
    "required": ["metrics"],
    "additionalProperties": false
}
